<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Task alerts (M5.1, docs/07 Android). Exact alarms are asked for
         with a rationale in M5.6; without them alerts fall back to inexact. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Loud dot-starts wake the screen like an alarm (docs/09 M6.5.5);
         Play Console declaration on the owner's release gates. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>
    <!-- Deep work in Focus: Do Not Disturb, alarms only (docs/09 M10.5). -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY"/>
    <!-- Device calendars (M7.1, docs/07 Android): read to show events;
         write for opt-in write-back (M7.3). The plugin asks for both at once. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <uses-permission android:name="android.permission.WRITE_CALENDAR"/>
    <application
        android:label="Dottoday"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:localeConfig="@xml/locales_config"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- dottoday://task/<id>, /day/<date>, /inbox … (07 shared, M5.0).
                 The router allow-lists every link. https App Links on dottoday.app need the
                 hosted assetlinks.json (release gate, docs/08 §6.1 D). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dottoday"/>
            </intent-filter>
            <!-- Share → Dottoday: text or a link becomes an Inbox task (B6,
                 docs/09 M12.4, intents/ShareIntake.kt). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
            <!-- Long-press shortcuts: Add task, What's next (B6, docs/09 M9.2c). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <!-- Done / +15 / Start from widgets and notifications, queued for the
             app (B6, docs/09 M9.2c). Only this app's PendingIntents reach it. -->
        <receiver android:exported="false" android:name=".intents.DotActionReceiver"/>
        <receiver android:exported="false" android:name=".focus.DeepWorkOff"/>
        <!-- Quick Settings tiles: Add task, Start focus (B6, docs/09 M9.5). -->
        <service
            android:name=".tiles.AddTaskTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_add"
            android:label="@string/shortcut_add_task"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <service
            android:name=".tiles.StartFocusTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_focus"
            android:label="@string/tile_start_focus"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
        </service>
        <!-- Home-screen widgets (docs/02 F9, docs/09 M5.4), Glance via home_widget. -->
        <receiver
            android:name=".widgets.NextUpWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_next_up_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_up_widget_info"/>
        </receiver>
        <receiver
            android:name=".widgets.TodayWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info"/>
        </receiver>
        <receiver
            android:name=".widgets.InboxWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_inbox_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/inbox_widget_info"/>
        </receiver>
        <!-- flutter_local_notifications: post scheduled alerts, keep them
             across reboots and app updates, and route action taps. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Re-arms reminders after a clock or time-zone change (M6.5.5);
             both broadcasts are exempt from Android 8's implicit limits. -->
        <receiver android:exported="false" android:name=".alarms.TimeChangeReceiver">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
