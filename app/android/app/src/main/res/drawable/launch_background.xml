<?xml version="1.0" encoding="utf-8"?>
<!-- Launch screen before Android 12 (docs/09 M8.6): the surface colour with
     the day-dot mark (drawable-xxxhdpi/splash_mark.png, night variant too). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_mark" />
    </item>
</layer-list>
