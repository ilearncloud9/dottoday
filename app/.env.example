# Copy to app/.env (git-ignored). Only PUBLIC values belong here.
# Compiled in via: flutter run --dart-define-from-file=.env (ADR-0005).
# Release: app/.env.prod with flutter build <target> --dart-define-from-file=.env.prod
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SENTRY_DSN=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Where Settings › Send feedback addresses its draft. PLACEHOLDER: a `.invalid`
# address (RFC 2606) is treated as unset, so the draft has no recipient and the
# person picks one. The owner puts the real monitored inbox in .env.prod
# (docs/08 §6.1 release gate).
FEEDBACK_EMAIL=feedback@dottoday.invalid
