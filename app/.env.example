# Copy to app/.env (git-ignored). Only PUBLIC values belong here.
# Compiled in via: flutter run --dart-define-from-file=.env (ADR-0005).
# Release: app/.env.prod with flutter build <target> --dart-define-from-file=.env.prod
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SENTRY_DSN=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Optional: where Settings › Send feedback addresses its draft (empty = user picks).
FEEDBACK_EMAIL=
