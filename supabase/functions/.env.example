# Edge Function secrets for local `supabase start` / `supabase functions serve`
# (copy to supabase/functions/.env, git-ignored). Hosted: `supabase secrets set`
# by the owner (docs/08 §6.1). Values starting with "placeholder" count as unset.

# Calendar OAuth clients (docs/09 M7.4). Console steps: docs/08 §6.1.
GOOGLE_CALENDAR_CLIENT_ID=placeholder-google-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=placeholder-google-client-secret
MICROSOFT_CALENDAR_CLIENT_ID=placeholder-microsoft-client-id
MICROSOFT_CALENDAR_CLIENT_SECRET=placeholder-microsoft-client-secret
MICROSOFT_CALENDAR_TENANT=common
# The provider redirects the browser here. Local: the host-reachable URL
# (inside the runtime SUPABASE_URL is http://kong:8000). Hosted: leave unset
# (defaults to <SUPABASE_URL>/functions/v1/calendar-oauth/callback).
CALENDAR_OAUTH_REDIRECT_URL=http://localhost:54321/functions/v1/calendar-oauth/callback
# Web app origins the browser may return to after connecting (comma-separated).
CALENDAR_RETURN_ORIGINS=http://localhost:8099,http://127.0.0.1:8099

# Existing functions (M6.5, M5.3b).
RESEND_API_KEY=
ACCOUNT_MAIL_FROM=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
