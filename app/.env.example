# Copy to app/.env (git-ignored). Only PUBLIC values belong here.
# Compiled in via: flutter run --dart-define-from-file=.env (ADR-0005).
# Release: app/.env.prod with flutter build <target> --dart-define-from-file=.env.prod
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SENTRY_DSN=
WEB_PUSH_VAPID_PUBLIC_KEY=
# Where Settings › Send feedback addresses its draft. Optional: empty means the
# compiled-in product inbox (Env.defaultFeedbackEmail).
FEEDBACK_EMAIL=feedback@dottoday.app
# The published privacy policy, https://dottoday.app/privacy.html once live.
# Empty = Settings › Privacy shows no link. The owner publishes the page and sets
# it in .env.prod before a store build (docs/08 §6.1 release gate, M8.6).
PRIVACY_POLICY_URL=
